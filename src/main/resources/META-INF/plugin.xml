<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.only1loatheb.additionalcustomsyntaxhiglight</id>
    <name>Additional Custom Syntax Highlight</name>
    <vendor>only1loatheb</vendor>
    <description><![CDATA[
        <p><b>Additional Custom Syntax Highlight</b> enables configurable regex-based word search highlighting on top of any language syntax highlighting.</p>
        <ul>
            <li>Highlight any regex pattern across all languages and file types.</li>
            <li>Configure text color (default), background color, bold/italic font styles, and text decorations (boxed, underline, strikeout).</li>
            <li>Restrict rules to specific file types or apply globally (*).</li>
            <li>Quick context menu action to highlight words or expressions directly from the editor.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <applicationListeners>
        <listener
            class="com.github.only1loatheb.additionalcustomsyntaxhiglight.listener.RegexEditorFactoryListener"
            topic="com.intellij.openapi.editor.event.EditorFactoryListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="editor"
            instance="com.github.only1loatheb.additionalcustomsyntaxhiglight.settings.HighlightSettingsConfigurable"
            id="com.github.only1loatheb.additionalcustomsyntaxhiglight.settings"
            displayName="Custom Regex Highlighting"/>

        <postStartupActivity
            implementation="com.github.only1loatheb.additionalcustomsyntaxhiglight.startup.RegexProjectActivity"/>
    </extensions>

    <actions>
        <action
            id="com.github.only1loatheb.additionalcustomsyntaxhiglight.actions.QuickHighlightAction"
            class="com.github.only1loatheb.additionalcustomsyntaxhiglight.actions.QuickHighlightAction"
            text="Add Regex Highlight..."
            description="Configure a regex highlight rule for selected text">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
